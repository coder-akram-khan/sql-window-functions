-- =====================================================
-- Create Product Table
-- This table stores product details such as
-- Product category, Brand, Product name, and Price
-- =====================================================
CREATE TABLE product
( 
    product_category varchar(255),  -- Category of the product
    brand varchar(255),             -- Brand name
    product_name varchar(255),      -- Product name
    price int                       -- Price in USD
);

