-- =====================================================
-- Create Employees Table
-- This table stores employee details such as
-- ID, Name, Department, and Salary
-- =====================================================
CREATE TABLE employees (
    emp_id INTEGER,                      -- Unique Employee ID
    emp_name CHARACTER VARYING(50),       -- Employee Name
    dept_name CHARACTER VARYING(50),      -- Department Name
    salary INTEGER                       -- Employee Salary
);

